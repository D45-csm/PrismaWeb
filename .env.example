# Configuración SMTP para enviar códigos de recuperación por correo.
# Para Gmail, usa una contraseña de aplicación; no uses la contraseña normal.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Entorno local. En producción, usa DJANGO_DEBUG=false, una clave secreta
# aleatoria, los dominios reales y los orígenes HTTPS de tu sitio.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
DJANGO_SECURE_HSTS_SECONDS=0

# En producción usa una caché compartida. Ejemplo con la caché de base de
# datos: django.core.cache.backends.db.DatabaseCache y ubicación django_cache.
# Para DatabaseCache, crea su tabla una vez con: python manage.py createcachetable
DJANGO_CACHE_BACKEND=
DJANGO_CACHE_LOCATION=

# Cinco fallos por combinación de IP/usuario y veinte fallos por IP
# durante quince minutos.
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_IP_MAX_ATTEMPTS=20
LOGIN_RATE_LIMIT_WINDOW=900
